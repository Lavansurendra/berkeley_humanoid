universe = container
container_image = docker://lavansurendra/wiscohumanoids:v1

log = $(Cluster).$(Process).log
error = $(Cluster).$(Process).err
output = $(Cluster).$(Process).out

# Requesting 10 CPUs to handle the 10 parallel MuJoCo environments
request_cpus = 10
request_memory = 32GB
request_disk = 60GB

executable = train.sh
arguments = --env-id G1Env --num_envs 20 --timesteps_per_env 50000 --xml_path environment/g1_scene.xml

transfer_input_files = environment/, train.py

# Retrieve training output and local W&B data upon exit
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = output/

queue 1